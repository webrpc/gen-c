webrpc = v1

name = smoke
version = v1.0.0
basepath = /rpc

enum Role: uint32
  - USER
  - ADMIN

type UserID: uint64

struct Profile
  - id: bigint
  - userId: UserID
  - name: string
  - role: Role
  - tags?: []string
  - meta?: map<string, string>

service Smoke
  - Echo(profile: Profile) => (profile: Profile)
